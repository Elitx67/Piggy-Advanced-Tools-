local function updateBoxFrameFromCorners(a, b)
    local minX = math.min(a.X, b.X)
    local minY = math.min(a.Y, b.Y)
    local maxX = math.max(a.X, b.X)
    local maxY = math.max(a.Y, b.Y)
    boxSelectFrame.Position = UDim2.fromOffset(minX, minY)
    boxSelectFrame.Size     = UDim2.fromOffset(maxX - minX, maxY - minY)
end

local _bsLastUpdate = 0
local function updateLiveBoxSelect()
    local now = tick()
    if now - _bsLastUpdate < 0.12 then return end
    _bsLastUpdate = now

    local minX = boxSelectFrame.AbsolutePosition.X
    local minY = boxSelectFrame.AbsolutePosition.Y
    local maxX = minX + boxSelectFrame.AbsoluteSize.X
    local maxY = minY + boxSelectFrame.AbsoluteSize.Y
    if (maxX - minX) < 8 or (maxY - minY) < 8 then return end

    local newSel = {}
    local newTarget = nil
    local hitSet = {}

    local buildModel = workspace:FindFirstChild("BuildModel") or workspace
    
    for _, obj in ipairs(buildModel:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local isSelectable = true
            if obj:FindFirstChildOfClass("Humanoid") then isSelectable = false end
            if obj.Name == "Baseplate" or obj:IsA("Terrain") then isSelectable = false end
            if obj:IsA("BasePart") and obj.Name == "MouseFilterPart" then isSelectable = false end
            if obj:IsA("BasePart") and obj.Name == "base" then isSelectable = false end
            if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") and obj.Parent:FindFirstChild("ColorPart") then
                isSelectable = false
            end

            if isSelectable then
                local cf, size
                if obj:IsA("Model") then
                    cf, size = obj:GetBoundingBox()
                else
                    cf, size = obj.CFrame, obj.Size
                end

                if cf and size then
                    local intersects = false
                    local corners = {
                        cf * CFrame.new( size.X/2,  size.Y/2,  size.Z/2),
                        cf * CFrame.new(-size.X/2,  size.Y/2,  size.Z/2),
                        cf * CFrame.new( size.X/2, -size.Y/2,  size.Z/2),
                        cf * CFrame.new( size.X/2,  size.Y/2, -size.Z/2),
                        cf * CFrame.new(-size.X/2, -size.Y/2,  size.Z/2),
                        cf * CFrame.new( size.X/2, -size.Y/2, -size.Z/2),
                        cf * CFrame.new(-size.X/2,  size.Y/2, -size.Z/2),
                        cf * CFrame.new(-size.X/2, -size.Y/2, -size.Z/2),
                        cf
                    }
                    for _, c in ipairs(corners) do
                        local sp, onScreen = cam:WorldToViewportPoint(c.Position)
                        if onScreen and sp.X >= minX and sp.X <= maxX and sp.Y >= minY and sp.Y <= maxY then
                            intersects = true
                            break
                        end
                    end

                    if intersects then
                        local realT = nil
                        if obj:IsA("Model") then
                            realT = obj
                        else
                            realT = getRealTarget(obj)
                        end

                        if realT and not hitSet[realT] then
                            hitSet[realT] = true
                            table.insert(newSel, realT)
                            newTarget = realT
                        end
                    end
                end
            end
        end
    end

    selectedObjects = newSel
    targetPart = newTarget
    if targetPart then
        updateProxy()
        outline.LineThickness = outlineThickness
        outline.Adornee = proxyPart
    else
        outline.Adornee = nil
        proxyPart.CFrame = CFrame.new(0, 10000, 0)
    end
    updatePanel()
end

