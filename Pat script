local function computeDraggedDistanceArrow(p5, p6, p7)
    local v8 = p7.Origin
    local v9 = p7.Direction.Unit
    local v10 = p6:Cross((v8 - p5).Unit)
    if v10:Dot(v10) < 0.0001 then return false end
    local v11 = p6:Cross(v10).Unit
    if v9:Dot(v11) < 0.0001 then return false end
    return true, (v8 + (p5 - v8):Dot(v11) / v9:Dot(v11) * v9 - p5):Dot(p6)
end

