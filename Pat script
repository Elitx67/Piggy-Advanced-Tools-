function updateProxy()
    pruneSelection()
    if #selectedObjects == 0 then proxyPart.CFrame = CFrame.new(0, 10000, 0); return end
    if #selectedObjects == 1 then
        local obj = selectedObjects[1]
        local cf, size = getBoundsOf(obj)
        proxyPart.Size = size; proxyPart.CFrame = cf; return
    end
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    for _, obj in ipairs(selectedObjects) do
        local cf, size
        if obj:IsA("Model") then cf, size = getModelVisualBox(obj)
        elseif obj:IsA("BasePart") then cf, size = obj.CFrame, obj.Size end
        if cf then
            local corners = {
                cf*CFrame.new( size.X/2,  size.Y/2,  size.Z/2),
                cf*CFrame.new(-size.X/2,  size.Y/2,  size.Z/2),
                cf*CFrame.new( size.X/2, -size.Y/2,  size.Z/2),
                cf*CFrame.new( size.X/2,  size.Y/2, -size.Z/2),
                cf*CFrame.new(-size.X/2,  size.Y/2, -size.Z/2),
                cf*CFrame.new(-size.X/2, -size.Y/2,  size.Z/2),
                cf*CFrame.new( size.X/2, -size.Y/2, -size.Z/2),
                cf*CFrame.new(-size.X/2, -size.Y/2, -size.Z/2)
            }
            for _, corner in ipairs(corners) do
                local p = corner.Position
                minX=math.min(minX,p.X); maxX=math.max(maxX,p.X)
                minY=math.min(minY,p.Y); maxY=math.max(maxY,p.Y)
                minZ=math.min(minZ,p.Z); maxZ=math.max(maxZ,p.Z)
            end
        end
    end
    proxyPart.Size = Vector3.new(maxX-minX, maxY-minY, maxZ-minZ)
    proxyPart.CFrame = CFrame.new((minX+maxX)/2, (minY+maxY)/2, (minZ+maxZ)/2)
end

