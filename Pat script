local function validVec(v)
    return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) ~= math.huge and math.abs(v.Y) ~= math.huge and math.abs(v.Z) ~= math.huge
end

function updateProxy()
    pruneSelection()
    if #selectedObjects == 0 then proxyPart.CFrame = CFrame.new(0, 10000, 0); return end
    if #selectedObjects == 1 then
        local cf, size = getBoundsOf(selectedObjects[1])
        if cf and size and validVec(size) then
            proxyPart.Size = size; proxyPart.CFrame = cf
        else
            proxyPart.CFrame = CFrame.new(0, 10000, 0)
        end
        return
    end
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local validCount = 0

    for _, obj in ipairs(selectedObjects) do
        local cf, size
        if obj:IsA("Model") then cf, size = getModelVisualBox(obj)
        elseif obj:IsA("BasePart") then cf, size = obj.CFrame, obj.Size end

        if cf and size and validVec(size) then
            validCount = validCount + 1
            local hx, hy, hz = size.X/2, size.Y/2, size.Z/2
            for sx = -1, 1, 2 do for sy = -1, 1, 2 do for sz = -1, 1, 2 do
                local p = (cf * CFrame.new(sx*hx, sy*hy, sz*hz)).Position
                if validVec(p) then
                    minX=math.min(minX,p.X); maxX=math.max(maxX,p.X)
                    minY=math.min(minY,p.Y); maxY=math.max(maxY,p.Y)
                    minZ=math.min(minZ,p.Z); maxZ=math.max(maxZ,p.Z)
                end
            end end end
        end
    end

    if validCount == 0 or minX == math.huge or minX ~= minX then
        proxyPart.CFrame = CFrame.new(0, 10000, 0); return
    end

    proxyPart.Size = Vector3.new(maxX-minX, maxY-minY, maxZ-minZ)
    proxyPart.CFrame = CFrame.new((minX+maxX)/2, (minY+maxY)/2, (minZ+maxZ)/2)
end

