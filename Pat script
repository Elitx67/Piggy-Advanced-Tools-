function invokeResizeVerified(container,targetCF,targetSize)
    local functions=Services.Replicated:FindFirstChild("Functions",true)
    local resizeFunc=functions and functions:FindFirstChild("CommitResize")
    if not resizeFunc or not container or not container.Parent then return false end
    local function matches()
        if not container.Parent then return true end
        if container:IsA("BasePart") then return (container.Size-targetSize).Magnitude<0.06 end
        for _,p in ipairs(container:GetDescendants()) do
            if p:IsA("BasePart") and p.Name~="MouseFilterPart" and p.Name~="base" and (p.Size-targetSize).Magnitude<0.06 then return true end
        end
        return false
    end
    local tried={}
    local function try(part)
        if not part or tried[part] or not part.Parent then return false end
        tried[part]=true
        pcall(function() resizeFunc:InvokeServer(container,{part,targetCF,targetSize}) end)
        task.wait(0.1); return matches()
    end
    if try(getResizeTarget(container)) then return true end
    local list={}
    for _,p in ipairs(container:GetDescendants()) do
        if p:IsA("BasePart") and p.Name~="MouseFilterPart" then list[#list+1]=p end
    end
    table.sort(list,function(a,b) return a.Size.X*a.Size.Y*a.Size.Z>b.Size.X*b.Size.Y*b.Size.Z end)
    for _,p in ipairs(list) do if try(p) then return true end end
    return false
end

