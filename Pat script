function snapshotObject(obj)
    if not obj or not obj.Parent then return nil end
    local snap = { instance=obj, cf=obj:GetPivot(), size=getObjSize(obj) }
    if obj:IsA("Model") then
        snap.parts = {}
        for _, p in ipairs(obj:GetDescendants()) do
            if p:IsA("BasePart") then snap.parts[#snap.parts+1] = {part=p, cf=p.CFrame, size=p.Size} end
        end
    end
    return snap
end

function snapshotSelection()
    local group = {}
    local list = (#selectedObjects>0) and selectedObjects or {targetPart}
    for _, obj in ipairs(list) do
        local sn = snapshotObject(obj)
        if sn then group[#group+1] = sn end
    end
    return group
end

function restoreSnapshot(sn)
    local obj = sn.instance
    if not obj or not obj.Parent then return end
    if sn.parts then
        for _, d in ipairs(sn.parts) do
            if d.part and d.part.Parent then d.part.Size=d.size; d.part.CFrame=d.cf end
        end
    else
        obj.Size = sn.size
        obj:PivotTo(sn.cf)
    end
    syncFilter(obj)
    forceUpdate(obj,"move"); forceUpdate(obj,"scale")
end

function saveState()
    if not targetPart then return end
