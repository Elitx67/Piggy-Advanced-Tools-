function getCirclePoint(axis, angle, radius)
    if axis=="X" then return Vector3.new(0,math.cos(angle)*radius,math.sin(angle)*radius)
    elseif axis=="Y" then return Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
    else return Vector3.new(math.cos(angle)*radius,math.sin(angle)*radius,0) end
end

function PAT_RotatorV2:BeginDrag(axis)
    if not targetPart or not useAdvancedRotate or currentMode~="rotate" or isDragging then return end
    lastHandleDownTick = tick()
    saveState(); saveOriginalTransparencies(); setObjectsTransparency(0.3)
    isDragging = true
    currentAxis = axis
    currentAngle = 0
    lockCamera()
    updateProxy()
    startPivot = proxyPart.CFrame
    originalCFrames = {}
    for _, obj in ipairs(selectedObjects) do originalCFrames[obj] = obj:GetPivot() end
    local mousePos = Services.UserInput:GetMouseLocation()
    local depth = (startPivot.Position - cam.CFrame.Position).Magnitude
    local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
    local localPos = startPivot:PointToObjectSpace(ray.Origin + ray.Direction * depth)
    if axis == "X" then initialAngle = math.atan2(localPos.Z, localPos.Y)
    elseif axis == "Y" then initialAngle = math.atan2(localPos.X, localPos.Z)
    elseif axis == "Z" then initialAngle = math.atan2(localPos.Y, localPos.X) end
    self:Update()
end

function PAT_RotatorV2:Build()
    for axis, color in pairs({X=toolColors.X, Y=toolColors.Y, Z=toolColors.Z}) do
        self.Visuals[axis] = {}
        for i = 1, self.SegmentCount do
            local seg = Instance.new("CylinderHandleAdornment", VisualFolder)
            seg.Color3 = color
            seg.Transparency = 1
            seg.AlwaysOnTop = true
            seg.ZIndex = 10
            seg.Adornee = nil
            seg.Visible = false
            table.insert(self.Visuals[axis], seg)
        end

        self.Hits[axis] = {}
        for i = 1, self.HitCount do
            local hit = Instance.new("SphereHandleAdornment", VisualFolder)
            hit.Color3 = color
            hit.Transparency = 1
            hit.AlwaysOnTop = true
            hit.ZIndex = 11
            hit.Adornee = nil
            hit.Visible = false
            hit.MouseEnter:Connect(function()
                self._hoverCount[axis] = (self._hoverCount[axis] or 0) + 1
                self.HoveredAxis = axis
                self:Update()
            end)
            hit.MouseLeave:Connect(function()
                self._hoverCount[axis] = math.max(0, (self._hoverCount[axis] or 0) - 1)
                if self._hoverCount[axis] == 0 and self.HoveredAxis == axis then
                    self.HoveredAxis = nil
                end
                self:Update()
            end)
            hit.MouseButton1Down:Connect(function()
                self:BeginDrag(axis)
            end)
            table.insert(self.Hits[axis], hit)
        end
    end

    self.Pivot = Instance.new("SphereHandleAdornment", VisualFolder)
    self.Pivot.Color3 = Color3.fromRGB(100, 180, 255)
    self.Pivot.Transparency = 0.35
    self.Pivot.AlwaysOnTop = true
    self.Pivot.ZIndex = 12
    self.Pivot.Adornee = nil
    self.Pivot.Visible = false
end

PAT_RotatorV2:Build()

function PAT_RotatorV2:HideAll()
    for axis, segments in pairs(self.Visuals) do
        for _, seg in ipairs(segments) do seg.Adornee = nil; seg.Visible = false end
        for _, hit in ipairs(self.Hits[axis]) do hit.Adornee = nil; hit.Visible = false end
    end
    if self.Pivot then self.Pivot.Adornee = nil; self.Pivot.Visible = false end
    self._geoRadius = nil; self._hitR = nil; self._pivR = nil; self._sig = {}
end

local function quant(v, step) return math.floor(v / step + 0.5) * step end

function PAT_RotatorV2:Update()
    local active = (targetPart ~= nil and currentMode == "rotate" and useAdvancedRotate)
    if isBarHidden and hideHandlesOnClose then active = false end
    if not active and not self.was then return end
    self.was = active
    if not active then self:HideAll(); return end

    local anchor = rotateProxy
    local radius = quant(math.clamp(proxyPart.Size.Magnitude * 0.5 + 1, 3, 80), 0.05)
    local camDist = (cam.CFrame.Position - rotateProxy.Position).Magnitude
    local sinFov = math.sin(math.rad(cam.FieldOfView))
    local thickness = quant(math.clamp(sinFov * camDist * 0.005, 0.03, 0.3), 0.005)
    local hitRadius = quant(math.clamp(sinFov * camDist * 0.05, 0.5, 2.5), 0.05)
    local pivRadius = quant(math.clamp(sinFov * camDist * 0.012, 0.1, 0.8), 0.02)

    if self._geoRadius ~= radius then
        self._geoRadius = radius
        self._sig = {}
        self._hitR = nil
        for axis, segments in pairs(self.Visuals) do
            for i, seg in ipairs(segments) do
                local angle = (i / self.SegmentCount) * math.pi * 2
                local nextAngle = ((i + 1) / self.SegmentCount) * math.pi * 2
                local p1 = getCirclePoint(axis, angle, radius)
                local p2 = getCirclePoint(axis, nextAngle, radius)
                seg.Adornee = anchor
                seg.Visible = true
                seg.CFrame = CFrame.lookAt((p1 + p2) / 2, (p1 + p2) / 2 + (p2 - p1).Unit)
                seg.Height = math.max((p1 - p2).Magnitude * 1.15, 0.05)
            end
            for i, hit in ipairs(self.Hits[axis]) do
                local angle = ((i - 0.5) / self.HitCount) * math.pi * 2
                hit.Adornee = anchor
                hit.Visible = true
                hit.Transparency = 1
                hit.CFrame = CFrame.new(getCirclePoint(axis, angle, radius))
            end
        end
        if self.Pivot then
            self.Pivot.Adornee = anchor
            self.Pivot.Visible = true
            self.Pivot.CFrame = CFrame.new(Vector3.zero)
        end
    end

    local activeAxis = isDragging and currentAxis or nil
    local hoveredAxis = self.HoveredAxis

    for axis, segments in pairs(self.Visuals) do
        local isActive = (axis == activeAxis)
        local isHovered = (axis == hoveredAxis) and not activeAxis
        local isDimmed = (activeAxis ~= nil and not isActive)

        local trans, thickMul
        if isDimmed then trans = 0.9; thickMul = 0.7
        elseif isActive then trans = 0; thickMul = 2.2
        elseif isHovered then trans = 0.05; thickMul = 1.6
        else trans = 0.45; thickMul = 1 end

        local key = trans .. "|" .. thickMul .. "|" .. thickness
        if self._sig[axis] ~= key then
            self._sig[axis] = key
            for _, seg in ipairs(segments) do
                seg.Transparency = trans
                seg.Radius = thickness * thickMul
            end
        end
    end

    if self._hitR ~= hitRadius then
        self._hitR = hitRadius
        for _, hits in pairs(self.Hits) do
            for _, hit in ipairs(hits) do hit.Radius = hitRadius end
        end
    end
    if self.Pivot and self._pivR ~= pivRadius then
        self._pivR = pivRadius
        self.Pivot.Radius = pivRadius
    end
end

function PAT_RotatorV2:Drag()
    if not (isDragging and currentMode=="rotate" and useAdvancedRotate and startPivot and currentAxis) then return end
    local mousePos=Services.UserInput:GetMouseLocation()
    local depth=(startPivot.Position-cam.CFrame.Position).Magnitude
    local ray=cam:ViewportPointToRay(mousePos.X,mousePos.Y)
    local localPos=startPivot:PointToObjectSpace(ray.Origin+ray.Direction*depth)
    local cur=0
    if currentAxis=="X" then cur=math.atan2(localPos.Z,localPos.Y)
    elseif currentAxis=="Y" then cur=math.atan2(localPos.X,localPos.Z)
    elseif currentAxis=="Z" then cur=math.atan2(localPos.Y,localPos.X) end
    local snap=math.rad(tonumber(snapInput and snapInput.Text or "15") or 15)
    if snap<=0 then snap=math.rad(1) end
    currentAngle=math.round((cur-initialAngle)/snap)*snap
    local rotDelta=(currentAxis=="X" and CFrame.Angles(currentAngle,0,0) or currentAxis=="Y" and CFrame.Angles(0,currentAngle,0) or CFrame.Angles(0,0,currentAngle))
    for _,obj in ipairs(selectedObjects) do
        local originalCF=originalCFrames[obj]
        if originalCF then
            local relative=startPivot:Inverse()*originalCF
            obj:PivotTo(startPivot*rotDelta*relative)
            syncFilter(obj)
        end
    end
    proxyDirty=true
end

function finishCustomRotate()
    if not isDragging then return end
    isDragging=false; restoreTransparencies(); unlockCamera()
    for _,obj in ipairs(selectedObjects) do forceUpdate(obj,currentMode) end
    originalCFrames={}; proxyDirty=true
    updateProxy()
    PAT_RotatorV2:Update()
end

