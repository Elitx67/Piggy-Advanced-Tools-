archBuildBtn.MouseButton1Click:Connect(function()
    local functions=Services.Replicated:FindFirstChild("Functions",true)
    if not functions then return end
    local placeFunc=functions:FindFirstChild("PlaceBlock"); local resizeFunc=functions:FindFirstChild("CommitResize"); local moveFunc=functions:FindFirstChild("CommitMove")
    if not (placeFunc and resizeFunc and moveFunc) then return end
    if not archPreviewModel then
        buildArchPreview()
        task.wait(0.1)
    end
    local blockData={}
    for _,p in ipairs(archPreviewModel:GetChildren()) do
        if p:IsA("BasePart") and p.Name:sub(1,8)=="ArchPrev" then
            table.insert(blockData,{cf=p.CFrame,size=p.Size})
        end
    end
    destroyArchPreview()
    archProgressText.Text="building arch..."
    loadAssets()
    playUISound()
    task.spawn(function()
        beginUndoGroup()
        local total=#blockData
        for i,b in ipairs(blockData) do
            archProgressText.Text="placing: "..i.."/"..total
            local tempCF=b.cf+Vector3.new(math.random(100,500),100,math.random(100,500))
            local ok,newBlock=pcall(function() return placeFunc:InvokeServer(safeBlockPath("Blocks","Basic","Block","Block"),tempCF,BrickColor.new("Medium stone grey"),Enum.Material.SmoothPlastic) end)
            if ok and newBlock then
                invokeResize(newBlock,tempCF,b.size)
                pcall(function() moveFunc:InvokeServer(newBlock,b.cf) end)
            end
            task.wait(fastBuild and 0.01 or 0.03)
        end
        endUndoGroup()
        archProgressText.Text="arch done! ("..total.." blocks)"
        task.wait(2); archProgressText.Text=""
    end)
    closeArchPanel()
end)

