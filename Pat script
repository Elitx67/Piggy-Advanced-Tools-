function syncFilter(target)
    if not target or not target.Parent then return end
    local container = target:IsA("Model") and target or target.Parent
    local currentCF = target:IsA("Model") and target:GetPivot() or target.CFrame
    local filter = container:FindFirstChild("MouseFilterPart")
    if filter and filter:IsA("BasePart") then
        filter.CFrame = currentCF
        if container:FindFirstChild("ColorPart") and target:IsA("BasePart") then filter.Size = target.Size end
    end
    local basePart = container:FindFirstChild("base")
    if basePart and basePart:IsA("BasePart") then
        basePart.CFrame = currentCF
        if container:FindFirstChild("ColorPart") and target:IsA("BasePart") then basePart.Size = target.Size end
    end
end

local moveTimestamps = {}

function forceUpdate(target, mode)
    if not target then return end
    local functions = Services.Replicated:FindFirstChild("Functions", true)
    if not functions then return end
    local container = (target.Name == "ColorPart" or target.Name == "MouseFilterPart" or target.Name == "base") and target.Parent or target
    
    if mode == "move" or mode == "rotate" then
        local commitMove = functions:FindFirstChild("CommitMove")
        if commitMove then 
            local expectedCF = container:GetPivot()
            local originalCF = container:GetAttribute("PAT_LastCF") or expectedCF
            container:SetAttribute("PAT_LastCF", expectedCF)
            
            pcall(function() commitMove:InvokeServer(container, expectedCF) end) 
            
            local currentTimestamp = tick()
            moveTimestamps[container] = currentTimestamp
            
            task.delay(0.6, function()
                if container and container.Parent and moveTimestamps[container] == currentTimestamp then
                    local actualCF = container:GetPivot()
                    if (actualCF.Position - originalCF.Position).Magnitude < 0.1 and (expectedCF.Position - originalCF.Position).Magnitude > 0.1 then
                        showToast("Server rejected the move (Out of bounds)", colorEliminarCard)
                    end
                end
            end)
        end
    elseif mode == "scale" or mode == "mirrorCopy" then
        local ok, finalSize = pcall(function() return getObjSize(container) end)
        if ok and finalSize then 
            invokeResize(container, container:GetPivot(), finalSize) 
            local expectedSize = finalSize
            local currentTimestamp = tick()
            moveTimestamps[container] = currentTimestamp
            
            task.delay(0.6, function()
                if container and container.Parent and moveTimestamps[container] == currentTimestamp then
                    local actualSize = getObjSize(container)
                    if (actualSize - expectedSize).Magnitude > 0.1 then
                        showToast("Server rejected the resize (Limit reached)", colorEliminarCard)
                    end
                end
            end)
        end
    end
end

DRAGGER_STATES = { None=0, Hovering=1, Dragging=2 }
DRAGGER_CONFIG = {
    None     = {Scale=0.4, Transparency=0.3},
    Hovering = {Scale=0.55, Transparency=0.1},
    Dragging = {Scale=0.5, Transparency=0}
}

function computeDraggedDistance(originPos, direction, mouseRay)
    local rayOrigin = mouseRay.Origin
    local rayDir = mouseRay.Direction.Unit
    local cross = direction:Cross(rayDir)
    if cross.Magnitude < 0.0001 then return false end
    local planeNormal = direction:Cross(cross).Unit
    local denom = rayDir:Dot(planeNormal)
    if math.abs(denom) < 0.0001 then return false end
    local t = (originPos - rayOrigin):Dot(planeNormal) / denom
    local hitPos = rayOrigin + rayDir * t
    return true, (hitPos - originPos):Dot(direction)
end

function updateSphereVisual(handle, state)
    local cfg = state == DRAGGER_STATES.Dragging and DRAGGER_CONFIG.Dragging
        or (state == DRAGGER_STATES.Hovering and DRAGGER_CONFIG.Hovering or DRAGGER_CONFIG.None)
    handle.Transparency = cfg.Transparency
    handle:SetAttribute("CurrentScale", cfg.Scale * handleScaleMul)
end

