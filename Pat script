local function getArchBlocks()
    local radius=math.clamp(tonumber(archRadiusBox.Text) or 10,0.5,200)
    local thick=math.clamp(tonumber(archThickBox.Text) or 1,0.05,50)
    local depth=math.clamp(tonumber(archDepthBox.Text) or 1,0.05,50)
    local arcDeg=math.clamp(tonumber(archAngleBox.Text) or 180,10,360)
    local segs=math.clamp(math.floor(tonumber(archSegBox.Text) or 12),2,64)
    local originCF
    if lp.Character then
        local root=lp.Character:FindFirstChild("HumanoidRootPart")
        if root then originCF=root.CFrame*CFrame.new(0,0,-radius*1.5) else originCF=CFrame.new(0,5,0) end
    else originCF=CFrame.new(0,5,0) end
    local arcRad=math.rad(arcDeg); local halfArc=arcRad/2; local segAngle=arcRad/segs
    local blockW=2*radius*math.sin(segAngle/2)
    local blocks={}
    for i=0,segs-1 do
        local angle=-halfArc+segAngle*(i+0.5)
        local x,y
        if archShapeType=="circle" then
            x=math.sin(angle)*radius; y=math.cos(angle)*radius
        else
            local t=angle/halfArc; x=t*radius; y=radius*(1-t*t)
        end
        local blockCF=originCF*CFrame.new(x,y,0)*CFrame.Angles(0,0,-angle)
        table.insert(blocks,{cf=blockCF,size=Vector3.new(blockW+0.05,thick,depth)})
    end
    return blocks
end

local function destroyArchPreview()
    if archPreviewModel then archPreviewModel:Destroy(); archPreviewModel=nil end
    if archPreviewHandles then archPreviewHandles:Destroy(); archPreviewHandles=nil end
    if archPreviewRotHandles then archPreviewRotHandles:Destroy(); archPreviewRotHandles=nil end
end

local function buildArchPreview()
    destroyArchPreview()
    local blocks=getArchBlocks()
    if #blocks==0 then return end
    archPreviewModel=Instance.new("Model"); archPreviewModel.Name="PAT_ArchPreview"; archPreviewModel.Parent=workspace
    for i,b in ipairs(blocks) do
        local p=Instance.new("Part"); p.Name="ArchPrev_"..i; p.Anchored=true; p.CanCollide=false; p.CanQuery=false; p.CastShadow=false
        p.Size=b.size; p.CFrame=b.cf; p.Color=Color3.fromRGB(120,180,255); p.Material=Enum.Material.Neon; p.Transparency=0.4
        p.Parent=archPreviewModel
    end
    local bc,bs=archPreviewModel:GetBoundingBox()
    local bounds=Instance.new("Part"); bounds.Name="PAT_ArchBounds"; bounds.Size=bs; bounds.CFrame=bc
    bounds.Transparency=1; bounds.Anchored=true; bounds.CanCollide=false; bounds.CanQuery=false
    bounds.Parent=archPreviewModel
    archPreviewHandles=Instance.new("Handles",HandlesParent); archPreviewHandles.Adornee=bounds; archPreviewHandles.Style=Enum.HandlesStyle.Movement; archPreviewHandles.Color3=toolColors.move
    archPreviewHandles.MouseButton1Down:Connect(function() archLastMoveDist=0 end)
    archPreviewHandles.MouseDrag:Connect(function(face,dist)
        local grid=0.5; local cur=math.floor(dist/grid+0.5)*grid; local delta=cur-archLastMoveDist
        if delta~=0 and archPreviewModel then archPreviewModel:TranslateBy(Vector3.FromNormalId(face)*delta); archLastMoveDist=cur end
    end)
    archPreviewHandles.MouseButton1Up:Connect(function() archLastMoveDist=0 end)
    archPreviewRotHandles=Instance.new("ArcHandles",HandlesParent); archPreviewRotHandles.Adornee=bounds; archPreviewRotHandles.Color3=toolColors.rotate
    archPreviewRotHandles.MouseButton1Down:Connect(function() archLastRotAngle=0 end)
    archPreviewRotHandles.MouseDrag:Connect(function(axis,angle)
        local grid=math.rad(15); local snap=math.floor(angle/grid+0.5)*grid; local delta=snap-archLastRotAngle
        if delta~=0 and archPreviewModel then archPreviewModel:PivotTo(archPreviewModel:GetPivot()*CFrame.fromAxisAngle(Vector3.FromAxis(axis),delta)); archLastRotAngle=snap end
    end)
    archPreviewRotHandles.MouseButton1Up:Connect(function() archLastRotAngle=0 end)
    archProgressText.Text="preview ready — move it, then BUILD"
end

