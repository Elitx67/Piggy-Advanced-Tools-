local function worldBounds(obj)
    local cf, size = getBoundsOf(obj)
    local ext = worldExtents(cf, size)
    return cf.Position, ext
end

local function performStudioAlign()
    if #selectedObjects < 1 or not targetPart then return end
    saveState()

    local tPos, tExt
    if alignRel == "Bounds" then
        local minV = Vector3.new(math.huge, math.huge, math.huge)
        local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
        for _, obj in ipairs(selectedObjects) do
            local p, e = worldBounds(obj)
            minV = Vector3.new(math.min(minV.X, p.X - e.X/2), math.min(minV.Y, p.Y - e.Y/2), math.min(minV.Z, p.Z - e.Z/2))
            maxV = Vector3.new(math.max(maxV.X, p.X + e.X/2), math.max(maxV.Y, p.Y + e.Y/2), math.max(maxV.Z, p.Z + e.Z/2))
        end
        tPos = (minV + maxV) / 2
        tExt = maxV - minV
    else
        tPos, tExt = worldBounds(targetPart)
    end

    local tMin = tPos - tExt/2
    local tMax = tPos + tExt/2
    local tCen = tPos

    for _, obj in ipairs(selectedObjects) do
        if alignRel == "Active" and obj == targetPart then continue end

        local cf = getBoundsOf(obj)
        local oPos, oExt = worldBounds(obj)
        local oMin = oPos - oExt/2
        local oMax = oPos + oExt/2
        local oCen = oPos
        local newPos = cf.Position

        if alignAxes.X then
            local tVal = (alignMode==1 and tMin.X) or (alignMode==2 and tCen.X) or tMax.X
            local oVal = (alignMode==1 and oMin.X) or (alignMode==2 and oCen.X) or oMax.X
            newPos = Vector3.new(newPos.X + (tVal - oVal), newPos.Y, newPos.Z)
        end
        if alignAxes.Y then
            local tVal = (alignMode==1 and tMin.Y) or (alignMode==2 and tCen.Y) or tMax.Y
            local oVal = (alignMode==1 and oMin.Y) or (alignMode==2 and oCen.Y) or oMax.Y
            newPos = Vector3.new(newPos.X, newPos.Y + (tVal - oVal), newPos.Z)
        end
        if alignAxes.Z then
            local tVal = (alignMode==1 and tMin.Z) or (alignMode==2 and tCen.Z) or tMax.Z
            local oVal = (alignMode==1 and oMin.Z) or (alignMode==2 and oCen.Z) or oMax.Z
            newPos = Vector3.new(newPos.X, newPos.Y, newPos.Z + (tVal - oVal))
        end

        obj:PivotTo(CFrame.new(newPos) * cf.Rotation)
        syncFilter(obj)
        forceUpdate(obj, "move")
    end

    updateProxy()
    playUISound()
    closeAlignPanel()
end

