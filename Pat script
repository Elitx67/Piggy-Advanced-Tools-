function worldExtents(cf, size)
    local _, _, _, r11, r12, r13, r21, r22, r23, r31, r32, r33 = cf:GetComponents()
    return Vector3.new(
        math.abs(r11)*size.X + math.abs(r12)*size.Y + math.abs(r13)*size.Z,
        math.abs(r21)*size.X + math.abs(r22)*size.Y + math.abs(r23)*size.Z,
        math.abs(r31)*size.X + math.abs(r32)*size.Y + math.abs(r33)*size.Z
    )
end

function isInvisibleBlock(obj)
    if obj:IsA("BasePart") then return obj.Transparency >= 1 end
    return false
end

function setObjectsTransparency(trans)
    for _, obj in ipairs(selectedObjects) do
        if obj:IsA("BasePart") then
            if not isInvisibleBlock(obj) then obj.Transparency = trans; obj.CastShadow = false end
        elseif obj:IsA("Model") then
            for _, child in ipairs(obj:GetDescendants()) do
                if child:IsA("BasePart") and not isInvisibleBlock(child) then
                    child.Transparency = trans; child.CastShadow = false
                end
            end
        end
    end
end

function saveOriginalTransparencies()
