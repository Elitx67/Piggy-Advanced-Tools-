                                            local cAxisMask=Vector3.new(math.abs(cLocalNormal.X),math.abs(cLocalNormal.Y),math.abs(cLocalNormal.Z))
                                            local ns=child.Size+(cAxisMask*delta)
                                            child.Size=Vector3.new(math.max(ns.X,0.05),math.max(ns.Y,0.05),math.max(ns.Z,0.05))
                                        end
                                    end
                                end
                                local newMCF,newMSize=getModelVisualBox(obj)
                                local mFilter=obj:FindFirstChild("MouseFilterPart")
                                local mBase=obj:FindFirstChild("base")
                                if mFilter then mFilter.Size=newMSize; mFilter.CFrame=newMCF end
                                if mBase then mBase.Size=newMSize; mBase.CFrame=newMCF end
                            end
                        end
                        lastSnappedDist = snapped
                        proxyDirty = true
                    end
                end
            end
        end)
        local releaseConn
        releaseConn = Services.UserInput.InputEnded:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
                isDragging=false; hState.mouseDown=false
                activeScaleFace = nil
                restoreTransparencies(); unlockCamera()
                updateSphereVisual(handle, hState.mouseHovering and DRAGGER_STATES.Hovering or DRAGGER_STATES.None)
                dragConn:Disconnect(); releaseConn:Disconnect()
                for _, obj in ipairs(selectedObjects) do forceUpdate(obj,"scale") end
                proxyDirty=true
            end
        end)
    end
    handle.MouseButton1Down:Connect(beginScaleDrag)
    hitHandle.MouseButton1Down:Connect(beginScaleDrag)
    table.insert(sphereHandlesList, handle)
    table.insert(sphereHitHandlesList, hitHandle)
end

