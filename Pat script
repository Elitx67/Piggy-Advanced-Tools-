end

function getBlockInfo(target)
    if not target then return nil end
    local container=target; local colorPart=nil
    if target:IsA("BasePart") then
        if target.Parent then
            local cp=target.Parent:FindFirstChild("ColorPart")
            if cp then colorPart=cp; container=target.Parent end
        end
        if not colorPart and target.Name=="ColorPart" then colorPart=target end
    elseif target:IsA("Model") then
        colorPart=target:FindFirstChild("ColorPart")
        if not colorPart then colorPart=target:FindFirstChildOfClass("BasePart") end
    end
    return container, colorPart
end

function getAABB(target)
    if target:IsA("Model") then
        local cf,size=getModelVisualBox(target)
        return cf,size,cf.Position-size/2,cf.Position+size/2
    else
        local cf,size=target.CFrame,target.Size
        return cf,size,cf.Position-size/2,cf.Position+size/2
    end
end

function splitBoxByBox(blockMin, blockMax, cutMin, cutMax)
    local intMin=Vector3.new(math.max(blockMin.X,cutMin.X),math.max(blockMin.Y,cutMin.Y),math.max(blockMin.Z,cutMin.Z))
    local intMax=Vector3.new(math.min(blockMax.X,cutMax.X),math.min(blockMax.Y,cutMax.Y),math.min(blockMax.Z,cutMax.Z))
    if intMin.X>=intMax.X-0.01 or intMin.Y>=intMax.Y-0.01 or intMin.Z>=intMax.Z-0.01 then
        return {{min=blockMin,max=blockMax}}
    end
    local result={}
    if intMin.X>blockMin.X+0.01 then table.insert(result,{min=blockMin,max=Vector3.new(intMin.X,blockMax.Y,blockMax.Z)}) end
    if intMax.X<blockMax.X-0.01 then table.insert(result,{min=Vector3.new(intMax.X,blockMin.Y,blockMin.Z),max=blockMax}) end
    if intMin.Y>blockMin.Y+0.01 then table.insert(result,{min=Vector3.new(intMin.X,blockMin.Y,blockMin.Z),max=Vector3.new(intMax.X,intMin.Y,blockMax.Z)}) end
    if intMax.Y<blockMax.Y-0.01 then table.insert(result,{min=Vector3.new(intMin.X,intMax.Y,blockMin.Z),max=Vector3.new(intMax.X,blockMax.Y,blockMax.Z)}) end
    if intMin.Z>blockMin.Z+0.01 then table.insert(result,{min=Vector3.new(intMin.X,intMin.Y,blockMin.Z),max=Vector3.new(intMax.X,intMax.Y,intMin.Z)}) end
    if intMax.Z<blockMax.Z-0.01 then table.insert(result,{min=Vector3.new(intMin.X,intMin.Y,intMax.Z),max=Vector3.new(intMax.X,intMax.Y,blockMax.Z)}) end
    return result
end

function getShapeType(container)
    local name=(container.Name or ""):lower()
    if name:find("sphere") then return "sphere" end
    if name:find("cylinder") then return "cylinder" end
    return "box"
end

function isPointInsideShape(container, worldPoint)
    local shape=getShapeType(container)
    local cf,size,_,_=getAABB(container)
    local localPt=cf:PointToObjectSpace(worldPoint)
    local hx,hy,hz=size.X/2,size.Y/2,size.Z/2
    if shape=="sphere" then
        local r=math.min(hx,hy,hz)
        return localPt.Magnitude<=r+0.01
    elseif shape=="cylinder" then
        local r=math.min(hx,hy)
        local radial=math.sqrt(localPt.X^2+localPt.Y^2)
        return math.abs(localPt.Z)<=hz+0.01 and radial<=r+0.01
    else
        return math.abs(localPt.X)<=hx+0.01 and math.abs(localPt.Y)<=hy+0.01 and math.abs(localPt.Z)<=hz+0.01
    end
end

function voxelizeShapeAdaptive(container, negateBoxes, baseRes)
    baseRes=baseRes or VOXEL_RESOLUTION
    local _,size,bmin,bmax=getAABB(container)
    local intMin=Vector3.new(math.huge,math.huge,math.huge)
    local intMax=Vector3.new(-math.huge,-math.huge,-math.huge)
    for _,nb in ipairs(negateBoxes) do
        if bmax.X>nb.min.X and bmin.X<nb.max.X and bmax.Y>nb.min.Y and bmin.Y<nb.max.Y and bmax.Z>nb.min.Z and bmin.Z<nb.max.Z then
            intMin=Vector3.new(math.min(intMin.X,math.max(bmin.X,nb.min.X)),math.min(intMin.Y,math.max(bmin.Y,nb.min.Y)),math.min(intMin.Z,math.max(bmin.Z,nb.min.Z)))
            intMax=Vector3.new(math.max(intMax.X,math.min(bmax.X,nb.max.X)),math.max(intMax.Y,math.min(bmax.Y,nb.max.Y)),math.max(intMax.Z,math.min(bmax.Z,nb.max.Z)))
        end
    end
    local coarseCell=Vector3.new(size.X/baseRes,size.Y/baseRes,size.Z/baseRes)
    local fineCell=coarseCell/2
    local fineZoneMin=intMin-coarseCell*2; local fineZoneMax=intMax+coarseCell*2
    local pieces={}
    for ix=0,baseRes-1 do for iy=0,baseRes-1 do for iz=0,baseRes-1 do
        local cc=bmin+Vector3.new((ix+0.5)*coarseCell.X,(iy+0.5)*coarseCell.Y,(iz+0.5)*coarseCell.Z)
        local ccMin=cc-coarseCell/2; local ccMax=cc+coarseCell/2
        if not (ccMax.X>fineZoneMin.X and ccMin.X<fineZoneMax.X and ccMax.Y>fineZoneMin.Y and ccMin.Y<fineZoneMax.Y and ccMax.Z>fineZoneMin.Z and ccMin.Z<fineZoneMax.Z) then
            if isPointInsideShape(container,cc) then
                local skip=false
                for _,nb in ipairs(negateBoxes) do
                    if ccMax.X>nb.min.X+0.01 and ccMin.X<nb.max.X-0.01 and ccMax.Y>nb.min.Y+0.01 and ccMin.Y<nb.max.Y-0.01 and ccMax.Z>nb.min.Z+0.01 and ccMin.Z<nb.max.Z-0.01 then skip=true; break end
                end
                if not skip then table.insert(pieces,{cf=CFrame.new(cc),size=coarseCell}) end
            end
        end
    end end end
    local fxMin=math.floor((fineZoneMin.X-bmin.X)/fineCell.X)-1; local fyMin=math.floor((fineZoneMin.Y-bmin.Y)/fineCell.Y)-1; local fzMin=math.floor((fineZoneMin.Z-bmin.Z)/fineCell.Z)-1
    local fxMax=math.ceil((fineZoneMax.X-bmin.X)/fineCell.X)+1; local fyMax=math.ceil((fineZoneMax.Y-bmin.Y)/fineCell.Y)+1; local fzMax=math.ceil((fineZoneMax.Z-bmin.Z)/fineCell.Z)+1
    for ix=fxMin,fxMax do for iy=fyMin,fyMax do for iz=fzMin,fzMax do
        local fc=bmin+Vector3.new((ix+0.5)*fineCell.X,(iy+0.5)*fineCell.Y,(iz+0.5)*fineCell.Z)
        if fc.X>=bmin.X-0.01 and fc.X<=bmax.X+0.01 and fc.Y>=bmin.Y-0.01 and fc.Y<=bmax.Y+0.01 and fc.Z>=bmin.Z-0.01 and fc.Z<=bmax.Z+0.01 then
            if fc.X>=fineZoneMin.X and fc.X<=fineZoneMax.X and fc.Y>=fineZoneMin.Y and fc.Y<=fineZoneMax.Y and fc.Z>=fineZoneMin.Z and fc.Z<=fineZoneMax.Z then
                if isPointInsideShape(container,fc) then
