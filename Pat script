function getShapeType(container)
    local name=(container.Name or ""):lower()
    if name:find("corner") then return "unsupported" end
    if name:find("sphere") then return "sphere" end
    if name:find("cylinder") then return "cylinder" end
    if name:find("wedge") then return "wedge" end
    return "box"
end

local function insideShape(shape, p, h)
    local nx, ny, nz = p.X/h.X, p.Y/h.Y, p.Z/h.Z
    if shape == "sphere" then return nx*nx + ny*ny + nz*nz <= 1.0001
    elseif shape == "cylinder" then return nx*nx + ny*ny <= 1.0001 and math.abs(nz) <= 1.0001
    elseif shape == "wedge" then return ny - nz <= 0.0001 and math.abs(nx) <= 1.0001 and math.abs(ny) <= 1.0001 and math.abs(nz) <= 1.0001
    end
    return true
end

local function splitBoxByBox(blockMin, blockMax, cutMin, cutMax)
    local intMin=Vector3.new(math.max(blockMin.X,cutMin.X),math.max(blockMin.Y,cutMin.Y),math.max(blockMin.Z,cutMin.Z))
    local intMax=Vector3.new(math.min(blockMax.X,cutMax.X),math.min(blockMax.Y,cutMax.Y),math.min(blockMax.Z,cutMax.Z))
    if intMin.X>=intMax.X-NEG_EPS or intMin.Y>=intMax.Y-NEG_EPS or intMin.Z>=intMax.Z-NEG_EPS then
        return {{min=blockMin,max=blockMax}}
    end
    local result={}
    if intMin.X>blockMin.X+NEG_EPS then table.insert(result,{min=blockMin,max=Vector3.new(intMin.X,blockMax.Y,blockMax.Z)}) end
    if intMax.X<blockMax.X-NEG_EPS then table.insert(result,{min=Vector3.new(intMax.X,blockMin.Y,blockMin.Z),max=blockMax}) end
    if intMin.Y>blockMin.Y+NEG_EPS then table.insert(result,{min=Vector3.new(intMin.X,blockMin.Y,blockMin.Z),max=Vector3.new(intMax.X,intMin.Y,blockMax.Z)}) end
    if intMax.Y<blockMax.Y-NEG_EPS then table.insert(result,{min=Vector3.new(intMin.X,intMax.Y,blockMin.Z),max=Vector3.new(intMax.X,blockMax.Y,blockMax.Z)}) end
    if intMin.Z>blockMin.Z+NEG_EPS then table.insert(result,{min=Vector3.new(intMin.X,intMin.Y,blockMin.Z),max=Vector3.new(intMax.X,intMax.Y,intMin.Z)}) end
    if intMax.Z<blockMax.Z-NEG_EPS then table.insert(result,{min=Vector3.new(intMin.X,intMin.Y,intMax.Z),max=Vector3.new(intMax.X,intMax.Y,blockMax.Z)}) end
    return result
end

local function localCutBox(tgtCF, cutCF, cutSize)
    local rel = tgtCF:Inverse() * cutCF
    local mn = Vector3.new(math.huge, math.huge, math.huge)
    local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
    local hx, hy, hz = cutSize.X/2, cutSize.Y/2, cutSize.Z/2
    for sx = -1, 1, 2 do for sy = -1, 1, 2 do for sz = -1, 1, 2 do
        local p = rel * Vector3.new(sx*hx, sy*hy, sz*hz)
        mn = Vector3.new(math.min(mn.X,p.X), math.min(mn.Y,p.Y), math.min(mn.Z,p.Z))
        mx = Vector3.new(math.max(mx.X,p.X), math.max(mx.Y,p.Y), math.max(mx.Z,p.Z))
    end end end
    return mn, mx
end

local function voxelizeLocal(shape, half, cuts, res)
    local pieces = {}
    local cell = Vector3.new(half.X*2/res, half.Y*2/res, half.Z*2/res)
    local origin = -half
    local zMin = Vector3.new(math.huge, math.huge, math.huge)
    local zMax = Vector3.new(-math.huge, -math.huge, -math.huge)
    for _, cb in ipairs(cuts) do
        zMin = Vector3.new(math.min(zMin.X,cb.min.X), math.min(zMin.Y,cb.min.Y), math.min(zMin.Z,cb.min.Z))
        zMax = Vector3.new(math.max(zMax.X,cb.max.X), math.max(zMax.Y,cb.max.Y), math.max(zMax.Z,cb.max.Z))
    end
    zMin = zMin - cell; zMax = zMax + cell

    local function cutHit(mn, mx)
        for _, cb in ipairs(cuts) do
            if mx.X > cb.min.X+NEG_EPS and mn.X < cb.max.X-NEG_EPS
            and mx.Y > cb.min.Y+NEG_EPS and mn.Y < cb.max.Y-NEG_EPS
            and mx.Z > cb.min.Z+NEG_EPS and mn.Z < cb.max.Z-NEG_EPS then return true end
        end
        return false
    end

    local function addRun(iy, iz, s, e)
        local mn = origin + Vector3.new(s*cell.X, iy*cell.Y, iz*cell.Z)
        local sz = Vector3.new((e-s+1)*cell.X, cell.Y, cell.Z)
        pieces[#pieces+1] = {center = mn + sz/2, size = sz}
    end

    local fine = cell / 2
    for iy = 0, res-1 do
        for iz = 0, res-1 do
            local runS = nil
            local runE = nil
            for ix = 0, res-1 do
                local mn = origin + Vector3.new(ix*cell.X, iy*cell.Y, iz*cell.Z)
                local mx = mn + cell
                local inZone = mx.X > zMin.X and mn.X < zMax.X and mx.Y > zMin.Y and mn.Y < zMax.Y and mx.Z > zMin.Z and mn.Z < zMax.Z
                local keepCoarse = false
                if not inZone then
                    keepCoarse = insideShape(shape, mn + cell/2, half)
                else
                    for fx = 0, 1 do for fy = 0, 1 do for fz = 0, 1 do
                        local fmn = mn + Vector3.new(fx*fine.X, fy*fine.Y, fz*fine.Z)
                        local fmx = fmn + fine
                        local fcen = fmn + fine/2
                        if insideShape(shape, fcen, half) and not cutHit(fmn, fmx) then
                            pieces[#pieces+1] = {center = fcen, size = fine}
                        end
                    end end end
                end
                if keepCoarse then
                    if runS == nil then runS = ix end
                    runE = ix
                elseif runS ~= nil then
                    addRun(iy, iz, runS, runE)
                    runS = nil
                end
            end
            if runS ~= nil then addRun(iy, iz, runS, runE) end
        end
    end
    return pieces
end

local function planTarget(container, cutters)
    local tcf, tsize = getBlockBox(container)
    local half = tsize / 2
    local cuts = {}
    local hit = false
    for _, c in ipairs(cutters) do
        local mn, mx = localCutBox(tcf, c.cf, c.size)
        cuts[#cuts+1] = {min = mn, max = mx}
        if mx.X > -half.X+NEG_EPS and mn.X < half.X-NEG_EPS
        and mx.Y > -half.Y+NEG_EPS and mn.Y < half.Y-NEG_EPS
        and mx.Z > -half.Z+NEG_EPS and mn.Z < half.Z-NEG_EPS then hit = true end
    end
    if not hit then return nil end

    local shape = getShapeType(container)
    local raw = {}
    if shape == "box" then
        local remaining = {{min = -half, max = half}}
        for _, cb in ipairs(cuts) do
            local nr = {}
            for _, pc in ipairs(remaining) do
                for _, s in ipairs(splitBoxByBox(pc.min, pc.max, cb.min, cb.max)) do nr[#nr+1] = s end
            end
            remaining = nr
        end
        for _, pc in ipairs(remaining) do raw[#raw+1] = {center = (pc.min + pc.max) / 2, size = pc.max - pc.min} end
    else
        raw = voxelizeLocal(shape, half, cuts, VOXEL_RESOLUTION)
    end

    local pieces = {}
    for _, p in ipairs(raw) do
        if p.size.X >= NEG_MIN_PIECE and p.size.Y >= NEG_MIN_PIECE and p.size.Z >= NEG_MIN_PIECE then pieces[#pieces+1] = p end
    end
    return {container = container, cf = tcf, shape = shape, pieces = pieces}
end

local function collectTargets(cutters)
    local ignore = {proxyPart, rotateProxy, negateProxy, globalMoveProxy}
    if negatePreviewFolder then ignore[#ignore+1] = negatePreviewFolder end
    if textPreviewModel then ignore[#ignore+1] = textPreviewModel end
    if lp.Character then ignore[#ignore+1] = lp.Character end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore

    local isCutter = {}
    for _, c in ipairs(cutters) do isCutter[c] = true end
    local cutParent = cutters[1] and cutters[1].Parent

    local seen, list = {}, {}
    for _, c in ipairs(cutters) do
        local cf, size = getBlockBox(c)
        local ok, parts = pcall(function()
            return workspace:GetPartBoundsInBox(cf, size + Vector3.new(0.2, 0.2, 0.2), params)
        end)
        if ok and parts then
            for _, part in ipairs(parts) do
                if not part:IsA("Terrain") and isSelectableHit(part) then
                    local cont = negateContainerOf(getRealTarget(part))
                    if cont and not seen[cont] and not isCutter[cont] and cont.Parent then
                        seen[cont] = true
                        if isBuildBlock(cont) or cont.Parent == cutParent then
                            list[#list+1] = cont
                        end
                    end
                end
            end
        end
    end
    return list
end

local function destroyBlockSafe(destroyFunc, obj)
    for attempt = 1, 2 do
        if not obj or not obj.Parent then return true end
        pcall(function() destroyFunc:InvokeServer(obj) end)
        for _ = 1, 5 do
            if not obj.Parent then return true end
            task.wait(0.06)
        end
    end
    return not (obj and obj.Parent)
end

local function runNegate(placeFunc, moveFunc, destroyFunc, fillFunc)
    destroyNegatePreview()
    showToast("Calculating cut...", colorInfo)

    local cutters, cutBoxes = {}, {}
    for _, c in ipairs(negateMarked) do
        if c and c.Parent then
            local cf, size = getBlockBox(c)
            cutters[#cutters+1] = c
            cutBoxes[#cutBoxes+1] = {cf = cf, size = size}
        end
    end
    if #cutters == 0 then showToast("No blocks marked!", colorEliminarCard); return end

    local targets = collectTargets(cutters)
    if #targets == 0 then showToast("No blocks found to cut. Check overlap.", colorEliminarCard); return end
    if #targets > NEG_MAX_TARGETS then showToast("Too many blocks in range ("..#targets..")", colorEliminarCard); return end

    local plans, total, skipped = {}, 0, 0
    for _, cont in ipairs(targets) do
        if getShapeType(cont) == "unsupported" then
            skipped = skipped + 1
        else
            local plan = planTarget(cont, cutBoxes)
            if plan then plans[#plans+1] = plan; total = total + #plan.pieces end
        end
    end
    if #plans == 0 then
        showToast(skipped > 0 and ("Nothing cut ("..skipped.." unsupported shape(s) skipped)") or "Marked blocks only touch, nothing to cut.", colorEliminarCard)
        return
    end
    if total > NEG_MAX_PIECES then
        showToast("Too many pieces ("..total.." > "..NEG_MAX_PIECES.."). Use a smaller cutter.", colorEliminarCard)
        return
    end

    showToast("Cutting "..#plans.." block(s), "..total.." pieces...", colorInfo)
    local stdAsset = findOriginalAsset("Block") or safeBlockPath("Blocks","Basic","Block","Block")
    local doneBlocks, failedBlocks, built = 0, 0, 0

    for _, plan in ipairs(plans) do
        local container = plan.container
        if container and container.Parent then
            local vp = getVisualPart(container)
            local brick = vp and vp.BrickColor or BrickColor.new("Medium stone grey")
            local mat = vp and vp.Material or Enum.Material.SmoothPlastic
            local asset = (plan.shape == "box") and (findOriginalAsset(getAssetName(container)) or stdAsset) or stdAsset

            local newBlocks, bad = {}, false
            for _, piece in ipairs(plan.pieces) do
                local pcf = plan.cf * CFrame.new(piece.center)
                local tempCF = pcf + Vector3.new(math.random(100,500), 100, math.random(100,500))
                local okP, nb = pcall(function() return placeFunc:InvokeServer(asset, tempCF, brick, mat) end)
                if okP and nb and nb.Parent then
                    invokeResize(nb, tempCF, piece.size)
                    if fillFunc then pcall(function() fillFunc:InvokeServer(nb, brick, mat) end) end
                    pcall(function() moveFunc:InvokeServer(nb, pcf) end)
                    newBlocks[#newBlocks+1] = nb
                else
                    bad = true
                    break
                end
                built = built + 1
                negateProgressText.Text = "rebuilding: "..built.."/"..total
                task.wait(fastBuild and 0.01 or 0.03)
            end

            if bad then
                for _, nb in ipairs(newBlocks) do pcall(function() destroyFunc:InvokeServer(nb) end) end
                failedBlocks = failedBlocks + 1
            else
                if not destroyBlockSafe(destroyFunc, container) then
                    showToast("Could not delete an original block", colorEliminarCard)
                end
                doneBlocks = doneBlocks + 1
            end
        end
    end

    if doneBlocks > 0 then
        for _, c in ipairs(cutters) do
            if c and c.Parent then destroyBlockSafe(destroyFunc, c) end
        end
        negateMarked = {}
        updateNegateCount()
        negateProgressText.Text = "done! ("..built.." pieces)"
        showToast("Negate complete! ("..doneBlocks.." cut"..(failedBlocks > 0 and (", "..failedBlocks.." failed") or "")..")", colorActivo)
        proxyDirty = true
    else
        negateProgressText.Text = ""
        showToast("Server rejected the cut. Nothing was changed.", colorEliminarCard)
    end
    task.delay(2, function() if negateProgressText and negateProgressText.Parent then negateProgressText.Text = "" end end)
end

function performRealNegate()
    if negateBusy then showToast("Negate is still running...", colorInfo); return end
    updateNegateCount()
    if #negateMarked == 0 then showToast("No blocks marked!", colorEliminarCard); return end
    local functions = getFunctions()
    if not functions then showToast("No Functions folder!", colorEliminarCard); return end
    local placeFunc = functions:FindFirstChild("PlaceBlock")
