function generate3DTextBlocks(textRaw,pixelSize,pixelGap,depth)
    local text=tostring(textRaw or ""):upper(); if text=="" then return nil end
    pixelSize=math.clamp(tonumber(pixelSize) or 0.8,0.05,20)
    pixelGap=math.clamp(tonumber(pixelGap) or 0,0,5)
    depth=math.clamp(tonumber(depth) or 0.8,0.05,20)
    local activeFont, fontW, fontH, fontAdv
    if selectedTextFontId == "3x5" then
        activeFont=FONT_3x5; fontW=3; fontH=5; fontAdv=4
    else
        activeFont=FONT_5x7; fontW=5; fontH=7; fontAdv=6
    end
    local cell=pixelSize+pixelGap
    local charAdv=(fontAdv+textLetterSpacing)*cell
    local totalWidth=#text*charAdv-(fontAdv-fontW+1)*cell
    local startX=-totalWidth/2
    local blocks={}

    local function isOn(pat,r,c)
        if r<1 or r>fontH or c<1 or c>fontW then return false end
        local rowStr=pat[r] or string.rep("0",fontW)
        return rowStr:sub(c,c)=="1"
    end

    local function isEdge(pat,r,c)
        if not isOn(pat,r,c) then return false end
        return not isOn(pat,r-1,c) or not isOn(pat,r+1,c) or not isOn(pat,r,c-1) or not isOn(pat,r,c+1)
    end

    for i=1,#text do
        local char=text:sub(i,i)
        local pat=activeFont[char] or activeFont["?"]
        local charStartX=startX+(i-1)*charAdv
        for row=1,fontH do
            local cidx=1
            while cidx<=fontW do
                local checkFn=textHollow and isEdge or isOn
                if checkFn(pat,row,cidx) then
                    local runEnd=cidx
                    if not textHollow then
                        while runEnd+1<=fontW and checkFn(pat,row,runEnd+1) do runEnd=runEnd+1 end
                    end
                    local runLength=runEnd-cidx+1
                    local px=charStartX+(cidx-1)*cell
                    local py=(fontH-row)*cell
                    local bw=runLength*pixelSize+(runLength-1)*pixelGap
                    local baseOffset=Vector3.new(px+bw/2,py+pixelSize/2,0)
                    if textSlant~=0 then baseOffset=Vector3.new(baseOffset.X+baseOffset.Y*textSlant,baseOffset.Y,baseOffset.Z) end
                    local finalCF
                    if textCurveRadius>0 then
                        local angle=baseOffset.X/textCurveRadius
                        local cx=math.sin(angle)*textCurveRadius
                        local cz=textCurveRadius-math.cos(angle)*textCurveRadius
                        finalCF=CFrame.new(cx,baseOffset.Y,cz)*CFrame.Angles(0,-angle,0)
                    end
                    table.insert(blocks,{letter=i,offset=baseOffset,size=Vector3.new(bw,pixelSize,depth),curveCF=finalCF})
                    cidx=runEnd+1
                else cidx=cidx+1 end
            end
        end
    end
    return blocks
end

