end

track(Services.UserInput.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end

    if not tooltipsEnabled or not isDragging then
        hideAllTips()
        return
    end

    if currentMode == "scale" then
        local size = proxyPart.Size
        if size.X ~= size.X or size.Y ~= size.Y or size.Z ~= size.Z then return end
        sizeTip.Text = fmtDim(size.X) .. ", " .. fmtDim(size.Y) .. ", " .. fmtDim(size.Z)
        placeTipAt(sizeTip, input.Position)
        sizeTip.Visible = true
        posTip.Visible = false; rotTip.Visible = false
    elseif currentMode == "move" then
        local p = proxyPart.Position
        posTip.Text = string.format("%.2f, %.2f, %.2f", p.X, p.Y, p.Z)
        placeTipAt(posTip, input.Position)
        posTip.Visible = true
        sizeTip.Visible = false; rotTip.Visible = false
    elseif currentMode == "rotate" and useAdvancedRotate and currentAxis then
        rotTip.Text = string.format("%s: %d°", currentAxis, math.deg(currentAngle))
        placeTipAt(rotTip, input.Position)
        rotTip.Visible = true
        sizeTip.Visible = false; posTip.Visible = false
    else
        hideAllTips()
    end
end))
