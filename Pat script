    if (hit.Name=="MouseFilterPart" or hit.Name=="base") and hit.Parent:FindFirstChild("ColorPart") then return hit.Parent.ColorPart end
    local model=hit:FindFirstAncestorOfClass("Model"); if model and model~=workspace and not model:FindFirstAncestorOfClass("Model") then return model end
