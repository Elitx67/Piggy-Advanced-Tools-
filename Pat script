performMirrorCopy=function(face)
    if #selectedObjects==0 then return end
    playUISound()
    local data={}; local normalVector=Vector3.FromNormalId(face)
    local pCF=proxyPart.CFrame; local pSize=proxyPart.Size
    for _,obj in ipairs(selectedObjects) do
        local cf=obj:GetPivot(); local size=getObjSize(obj); local visualPart=getVisualPart(obj)
        if visualPart then
            local localCF=pCF:Inverse()*cf; local pos=localCF.Position; local x,y,z=pos.X,pos.Y,pos.Z
            local look=localCF.LookVector; local up=localCF.UpVector
            if math.abs(normalVector.X)>0.5 then x=-x; look=Vector3.new(-look.X,look.Y,look.Z); up=Vector3.new(-up.X,up.Y,up.Z)
            elseif math.abs(normalVector.Y)>0.5 then y=-y; look=Vector3.new(look.X,-look.Y,look.Z); up=Vector3.new(up.X,-up.Y,up.Z)
            elseif math.abs(normalVector.Z)>0.5 then z=-z; look=Vector3.new(look.X,look.Y,-look.Z); up=Vector3.new(up.X,up.Y,-up.Z) end
            local right=look:Cross(up)
            local newLocalCF=CFrame.fromMatrix(Vector3.new(x,y,z),right,up,-look)
            local shift=normalVector*Vector3.new(pSize.X*math.abs(normalVector.X),pSize.Y*math.abs(normalVector.Y),pSize.Z*math.abs(normalVector.Z))
            local newCenterProxy=pCF*CFrame.new(shift)
            local targetCF=newCenterProxy*newLocalCF
            local assetName=(obj:IsA("Model") and obj.Name) or (obj.Parent and obj.Parent.Name) or "Block"
            table.insert(data,{cf={targetCF:GetComponents()},size={size.X,size.Y,size.Z},color=visualPart.BrickColor.Number,material=visualPart.Material.Name,originalName=assetName})
        end
    end
    task.spawn(function()
        local functions=Services.Replicated:FindFirstChild("Functions",true)
        local placeFunc=functions:FindFirstChild("PlaceBlock"); local resizeFunc=functions:FindFirstChild("CommitResize")
        local fillFunc=functions:FindFirstChild("FillBlock"); local moveFunc=functions:FindFirstChild("CommitMove")
        for _,block in ipairs(data) do
            local originalCF=CFrame.new(unpack(block.cf))
