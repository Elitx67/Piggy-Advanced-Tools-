local function fmtDim(v)
    local r = math.floor(v * 100 + 0.5) / 100
    if math.abs(r - math.floor(r + 0.5)) < 0.001 then
        return tostring(math.floor(r + 0.5))
    end
    return string.format("%.2f", r)
end

