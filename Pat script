function getModelVisualBox(model)
    local pivot = model:GetPivot()
    local mn = Vector3.new(math.huge, math.huge, math.huge)
    local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
    local found = false
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "MouseFilterPart" and p.Name ~= "base" then
            found = true
            local rel = pivot:ToObjectSpace(p.CFrame)
            local x, y, z, r11, r12, r13, r21, r22, r23, r31, r32, r33 = rel:GetComponents()
            local sz = p.Size
            local hx = (math.abs(r11) * sz.X + math.abs(r12) * sz.Y + math.abs(r13) * sz.Z) / 2
            local hy = (math.abs(r21) * sz.X + math.abs(r22) * sz.Y + math.abs(r23) * sz.Z) / 2
            local hz = (math.abs(r31) * sz.X + math.abs(r32) * sz.Y + math.abs(r33) * sz.Z) / 2
            mn = Vector3.new(math.min(mn.X, x - hx), math.min(mn.Y, y - hy), math.min(mn.Z, z - hz))
            mx = Vector3.new(math.max(mx.X, x + hx), math.max(mx.Y, y + hy), math.max(mx.Z, z + hz))
        end
    end
    if not found then return model:GetBoundingBox() end
    return pivot * CFrame.new((mn + mx) / 2), mx - mn
end

function getBoundsOf(obj)
    if obj:IsA("Model") then return getModelVisualBox(obj) end
    return obj.CFrame, obj.Size
end

function getObjSize(obj)
    if obj:IsA("Model") then local _, sz = getModelVisualBox(obj); return sz end
    return obj.Size
end

function getResizeTarget(container)
    if not container or not container.Parent then return nil end
    if container:IsA("BasePart") then return container end
    if container:IsA("Model") then
        local capBase = container:FindFirstChild("Base")
        if capBase and capBase:IsA("BasePart") then return capBase end
        local cp = container:FindFirstChild("ColorPart")
        if cp and cp:IsA("BasePart") then return cp end
        local lowBase = container:FindFirstChild("base")
        if lowBase and lowBase:IsA("BasePart") then return lowBase end
        if container.PrimaryPart and container.PrimaryPart.Name ~= "MouseFilterPart" then return container.PrimaryPart end
        for _, c in ipairs(container:GetDescendants()) do
            if c:IsA("BasePart") and c.Name ~= "MouseFilterPart" and c.Name ~= "base" then return c end
        end
    end
    return nil
end

function getVisualPart(container)
    if not container then return nil end
    if container:IsA("BasePart") then return container end
    if container:IsA("Model") then
        local cp = container:FindFirstChild("ColorPart")
        if cp and cp:IsA("BasePart") then return cp end
        local capBase = container:FindFirstChild("Base")
        if capBase and capBase:IsA("BasePart") then return capBase end
        local lowBase = container:FindFirstChild("base")
        if lowBase and lowBase:IsA("BasePart") then return lowBase end
        if container.PrimaryPart then return container.PrimaryPart end
        for _, c in ipairs(container:GetDescendants()) do
            if c:IsA("BasePart") then return c end
        end
    end
    return nil
end

function invokeResize(container, targetCF, targetSize)
    local functions = Services.Replicated:FindFirstChild("Functions", true)
    if not functions then return end
    local resizeFunc = functions:FindFirstChild("CommitResize")
    if not resizeFunc then return end
    local target = getResizeTarget(container)
    if target then
        pcall(function() resizeFunc:InvokeServer(container, {target, targetCF, targetSize}) end)
    else
        pcall(function() resizeFunc:InvokeServer(container, {container, targetCF, targetSize}) end)
    end
end

