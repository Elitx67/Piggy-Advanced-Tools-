local function updateBoxFrameFromCorners(a, b)
    local minX = math.min(a.X, b.X)
    local minY = math.min(a.Y, b.Y)
    local maxX = math.max(a.X, b.X)
    local maxY = math.max(a.Y, b.Y)
    boxSelectFrame.Position = UDim2.fromOffset(minX, minY)
    boxSelectFrame.Size     = UDim2.fromOffset(maxX - minX, maxY - minY)
end

local _bsLastUpdate = 0
local MAX_BOX_SELECT = 250

local function buildBoxSelectCache()
    bsCache = {}
    local root = workspace:FindFirstChild("BuildModel") or workspace
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local isSelectable = true
            if obj:IsA("Terrain") or obj.Name == "Baseplate" then isSelectable = false end
            if isSelectable and obj:IsA("BasePart") then
                if obj.Name == "MouseFilterPart" or obj.Name == "base" then isSelectable = false
                elseif obj.Parent and obj.Parent:IsA("Model") and obj.Parent:FindFirstChild("ColorPart") then isSelectable = false end
            end
            if isSelectable and obj:FindFirstChildOfClass("Humanoid") then isSelectable = false end
            if isSelectable and not isSelectableHit(obj) then isSelectable = false end

            if isSelectable then
                local cf, size
                if obj:IsA("Model") then cf, size = obj:GetBoundingBox() else cf, size = obj.CFrame, obj.Size end
                if cf and size and validVec(size) then
                    local realT = obj:IsA("Model") and obj or getRealTarget(obj)
                    if realT then bsCache[#bsCache+1] = {t = realT, cf = cf, size = size} end
                end
            end
        end
    end
end

local function updateLiveBoxSelect()
    local now = tick()
    local throttle = IS_MOBILE and 0.25 or 0.15
    if now - _bsLastUpdate < throttle then return end
    _bsLastUpdate = now

    local minX = boxSelectFrame.AbsolutePosition.X
    local minY = boxSelectFrame.AbsolutePosition.Y
    local maxX = minX + boxSelectFrame.AbsoluteSize.X
    local maxY = minY + boxSelectFrame.AbsoluteSize.Y
    if (maxX - minX) < 8 or (maxY - minY) < 8 then return end

    if not bsCache then buildBoxSelectCache() end

    local newSel, newTarget, hitSet, count = {}, nil, {}, 0

    for _, e in ipairs(bsCache) do
        if count >= MAX_BOX_SELECT then break end
        local realT = e.t
        if realT.Parent and not hitSet[realT] then
            local cf, size = e.cf, e.size
            local centerPos, centerOnScreen = cam:WorldToViewportPoint(cf.Position)
            if centerOnScreen and centerPos.X == centerPos.X and centerPos.Y == centerPos.Y then
                local margin = math.max(size.X, size.Y, size.Z) * 50
                if centerPos.X + margin > minX and centerPos.X - margin < maxX and centerPos.Y + margin > minY and centerPos.Y - margin < maxY then
                    local intersects = false
                    local hx, hy, hz = size.X/2, size.Y/2, size.Z/2
                    local pts = {
                        cf.Position,
                        (cf * CFrame.new( hx,  hy,  hz)).Position, (cf * CFrame.new(-hx,  hy,  hz)).Position,
                        (cf * CFrame.new( hx, -hy,  hz)).Position, (cf * CFrame.new( hx,  hy, -hz)).Position,
                        (cf * CFrame.new(-hx, -hy,  hz)).Position, (cf * CFrame.new( hx, -hy, -hz)).Position,
                        (cf * CFrame.new(-hx,  hy, -hz)).Position, (cf * CFrame.new(-hx, -hy, -hz)).Position,
                    }
                    for _, wp in ipairs(pts) do
                        local sp, onScreen = cam:WorldToViewportPoint(wp)
                        if onScreen and sp.X == sp.X and sp.Y == sp.Y and sp.X >= minX and sp.X <= maxX and sp.Y >= minY and sp.Y <= maxY then
                            intersects = true
                            break
                        end
                    end
                    if intersects then
                        hitSet[realT] = true
                        newSel[#newSel+1] = realT
                        newTarget = realT
                        count = count + 1
                    end
                end
            end
        end
    end

    selectedObjects = newSel
    targetPart = newTarget
    if targetPart then
        updateProxy()
        outline.LineThickness = outlineThickness
        outline.Adornee = proxyPart
    else
        outline.Adornee = nil
        proxyPart.CFrame = CFrame.new(0, 10000, 0)
    end
    updatePanel()
end

