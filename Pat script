function getCirclePoint(axis, angle, radius)
    if axis=="X" then return Vector3.new(0,math.cos(angle)*radius,math.sin(angle)*radius)
    elseif axis=="Y" then return Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
    else return Vector3.new(math.cos(angle)*radius,math.sin(angle)*radius,0) end
end

function PAT_RotatorV2:Build()
    for axis, color in pairs({X=toolColors.X,Y=toolColors.Y,Z=toolColors.Z}) do
        self.Visuals[axis]={}
        for i=1,60 do
            local sgm=Instance.new("CylinderHandleAdornment",VisualFolder)
            sgm.Color3=color; sgm.Transparency=1; sgm.AlwaysOnTop=true; sgm.ZIndex=10
            table.insert(self.Visuals[axis],sgm)
        end
        self.Handles[axis]={}
        for i=1,2 do
            local h=Instance.new("SphereHandleAdornment",VisualFolder)
            h.Color3=color; h.AlwaysOnTop=true; h.ZIndex=11; h.Adornee=nil; h.Visible=false; h.Transparency=1
            h.MouseButton1Down:Connect(function()
                if not targetPart or not useAdvancedRotate or currentMode~="rotate" or isDragging then return end
                lastHandleDownTick=tick()
                saveState(); saveOriginalTransparencies(); setObjectsTransparency(0.3)
                isDragging=true; currentAxis=axis; currentAngle=0
                lockCamera()
                updateProxy()
                startPivot=proxyPart.CFrame
                originalCFrames={}
                for _, obj in ipairs(selectedObjects) do originalCFrames[obj]=obj:GetPivot() end
                local mousePos=Services.UserInput:GetMouseLocation()
                local depth=(startPivot.Position-cam.CFrame.Position).Magnitude
                local ray=cam:ViewportPointToRay(mousePos.X,mousePos.Y)
                local localPos=startPivot:PointToObjectSpace(ray.Origin+ray.Direction*depth)
                if axis=="X" then initialAngle=math.atan2(localPos.Z,localPos.Y)
                elseif axis=="Y" then initialAngle=math.atan2(localPos.X,localPos.Z)
                elseif axis=="Z" then initialAngle=math.atan2(localPos.Y,localPos.X) end
            end)
            table.insert(self.Handles[axis],h)
        end
    end
end
PAT_RotatorV2:Build()

function PAT_RotatorV2:Update()
    local active=(targetPart~=nil and currentMode=="rotate" and useAdvancedRotate)
    if isBarHidden and hideHandlesOnClose then active=false end
    if not active and not self.was then return end
    self.was=active
    local anchor=rotateProxy
    for axis,segments in pairs(self.Visuals) do
        local isCurrent=(axis==currentAxis and isDragging)
        local trans=1
        if active then
            if isDragging then trans=isCurrent and 0 or 1 else trans=0.4 end
        end
        for _,v in ipairs(segments) do v.Adornee=active and anchor or nil; v.Transparency=trans end
        for _,h in ipairs(self.Handles[axis]) do h.Adornee=active and anchor or nil; h.Visible=active; h.Transparency=1 end
    end
    if not active then return end
    local radius=6; local thickness=0.05
    for axis,segments in pairs(self.Visuals) do
        for i,segment in ipairs(segments) do
            local angle,nxt=(i/60)*math.pi*2,((i+1)/60)*math.pi*2
            local p1,p2=getCirclePoint(axis,angle,radius),getCirclePoint(axis,nxt,radius)
            segment.CFrame=CFrame.lookAt((p1+p2)/2,(p1+p2)/2+(p2-p1).Unit)
            segment.Height=math.max((p1-p2).Magnitude,0.05); segment.Radius=thickness
        end
        for _,h in ipairs(self.Handles[axis]) do h.Radius=1.2 end
        if axis=="Z" then self.Handles[axis][1].CFrame=CFrame.new(radius,0,0); self.Handles[axis][2].CFrame=CFrame.new(-radius,0,0)
        elseif axis=="Y" then self.Handles[axis][1].CFrame=CFrame.new(0,0,radius); self.Handles[axis][2].CFrame=CFrame.new(0,0,-radius)
        else self.Handles[axis][1].CFrame=CFrame.new(0,radius,0); self.Handles[axis][2].CFrame=CFrame.new(0,-radius,0) end
    end
end

function PAT_RotatorV2:Drag()
    if not (isDragging and currentMode=="rotate" and useAdvancedRotate and startPivot and currentAxis) then return end
    local mousePos=Services.UserInput:GetMouseLocation()
    local depth=(startPivot.Position-cam.CFrame.Position).Magnitude
    local ray=cam:ViewportPointToRay(mousePos.X,mousePos.Y)
    local localPos=startPivot:PointToObjectSpace(ray.Origin+ray.Direction*depth)
    local cur=0
    if currentAxis=="X" then cur=math.atan2(localPos.Z,localPos.Y)
    elseif currentAxis=="Y" then cur=math.atan2(localPos.X,localPos.Z)
    elseif currentAxis=="Z" then cur=math.atan2(localPos.Y,localPos.X) end
    local snap=math.rad(tonumber(snapInput and snapInput.Text or "15") or 15)
    if snap<=0 then snap=math.rad(1) end
    currentAngle=math.round((cur-initialAngle)/snap)*snap
    local rotDelta=(currentAxis=="X" and CFrame.Angles(currentAngle,0,0) or currentAxis=="Y" and CFrame.Angles(0,currentAngle,0) or CFrame.Angles(0,0,currentAngle))
    for _,obj in ipairs(selectedObjects) do
        local originalCF=originalCFrames[obj]
        if originalCF then
            local relative=startPivot:Inverse()*originalCF
            obj:PivotTo(startPivot*rotDelta*relative)
            syncFilter(obj)
        end
    end
    proxyDirty=true
end

function finishCustomRotate()
    if not isDragging then return end
    isDragging=false; restoreTransparencies(); unlockCamera()
    for _,obj in ipairs(selectedObjects) do forceUpdate(obj,currentMode) end
    originalCFrames={}; proxyDirty=true
    PAT_RotatorV2:Update()
end

