function performRealNegate()
    if #negateMarked==0 then return end
    local functions=Services.Replicated:FindFirstChild("Functions",true)
    if not functions then return end
    local placeFunc=functions:FindFirstChild("PlaceBlock")
    local resizeFunc=functions:FindFirstChild("CommitResize")
    local fillFunc=functions:FindFirstChild("FillBlock")
    local moveFunc=functions:FindFirstChild("CommitMove")
    local destroyFunc=functions:FindFirstChild("DestroyBlock")
    if not (placeFunc and resizeFunc and moveFunc and destroyFunc) then return end

    destroyNegatePreview()

    local negateBoxes={}; local markedSet={}
    for _,obj in ipairs(negateMarked) do
        markedSet[obj]=true
        local _,_,bmin,bmax=getAABB(obj)
        table.insert(negateBoxes,{min=bmin,max=bmax,source=obj})
    end
    local toDelete={}; local toRebuild={}; local processed={}; local rebuildKeys={}
    for _,nbox in ipairs(negateBoxes) do
        local region=Region3.new(nbox.min-Vector3.new(0.5,0.5,0.5),nbox.max+Vector3.new(0.5,0.5,0.5))
        local parts=workspace:FindPartsInRegion3WithIgnoreList(region,{proxyPart,rotateProxy,negateProxy,lp.Character},500)
        for _,part in ipairs(parts) do
            local realTarget=getRealTarget(part)
            if realTarget and not processed[realTarget] then
                processed[realTarget]=true
                local container,colorPart=getBlockInfo(realTarget)
                if container then
                    local _,_,bmin,bmax=getAABB(container)
                    local overlapped=bmax.X>nbox.min.X+0.01 and bmin.X<nbox.max.X-0.01 and bmax.Y>nbox.min.Y+0.01 and bmin.Y<nbox.max.Y-0.01 and bmax.Z>nbox.min.Z+0.01 and bmin.Z<nbox.max.Z-0.01
                    if overlapped then
                        table.insert(toDelete,container)
                        local shape=getShapeType(container)
                        local brick=colorPart and colorPart.BrickColor or BrickColor.new("Medium stone grey")
                        local material=colorPart and colorPart.Material or Enum.Material.SmoothPlastic
                        local assetName=(container:IsA("Model") and container.Name) or (container.Parent and container.Parent.Name) or "Block"
                        if shape=="cylinder" or shape=="sphere" then
                            local voxels=voxelizeShapeAdaptive(container,negateBoxes,VOXEL_RESOLUTION)
                            for _,v in ipairs(voxels) do
                                local key=string.format("%.2f_%.2f_%.2f_%.2f_%.2f_%.2f",v.cf.Position.X,v.cf.Position.Y,v.cf.Position.Z,v.size.X,v.size.Y,v.size.Z)
                                if not rebuildKeys[key] then rebuildKeys[key]=true; table.insert(toRebuild,{cf=v.cf,size=v.size,brickColor=brick,material=material,assetName="Block"}) end
                            end
                        else
                            local remaining={{min=bmin,max=bmax}}
                            for _,nbox2 in ipairs(negateBoxes) do
                                local newRemaining={}
                                for _,piece in ipairs(remaining) do
                                    local o=piece.max.X>nbox2.min.X+0.01 and piece.min.X<nbox2.max.X-0.01 and piece.max.Y>nbox2.min.Y+0.01 and piece.min.Y<nbox2.max.Y-0.01 and piece.max.Z>nbox2.min.Z+0.01 and piece.min.Z<nbox2.max.Z-0.01
                                    if o then
                                        local split=splitBoxByBox(piece.min,piece.max,nbox2.min,nbox2.max)
                                        for _,s in ipairs(split) do table.insert(newRemaining,s) end
                                    else table.insert(newRemaining,piece) end
                                end
                                remaining=newRemaining
                            end
                            for _,piece in ipairs(remaining) do
                                local pc=(piece.min+piece.max)/2; local ps=piece.max-piece.min
                                if ps.X>0.05 and ps.Y>0.05 and ps.Z>0.05 then
                                    local key=string.format("%.2f_%.2f_%.2f_%.2f_%.2f_%.2f",pc.X,pc.Y,pc.Z,ps.X,ps.Y,ps.Z)
                                    if not rebuildKeys[key] then rebuildKeys[key]=true; table.insert(toRebuild,{cf=CFrame.new(pc),size=ps,brickColor=brick,material=material,assetName=assetName}) end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    for _,obj in ipairs(toDelete) do pcall(function() destroyFunc:InvokeServer(obj) end) end
    for _,obj in ipairs(negateMarked) do if not processed[obj] then pcall(function() destroyFunc:InvokeServer(obj) end) end end
    task.wait(0.15)
    for _,obj in ipairs(toDelete) do pcall(function() destroyFunc:InvokeServer(obj) end) end
    local total=#toRebuild
    task.spawn(function()
        for i,b in ipairs(toRebuild) do
            negateProgressText.Text="rebuilding: "..i.."/"..total
            local tempCF=b.cf+Vector3.new(math.random(100,500),100,math.random(100,500))
            local assetToPlace=findOriginalAsset(b.assetName) or safeBlockPath("Blocks","Basic","Block","Block")
            local ok,newBlock=pcall(function() return placeFunc:InvokeServer(assetToPlace,tempCF,b.brickColor,b.material) end)
            if ok and newBlock then
                invokeResize(newBlock,tempCF,b.size)
                if fillFunc then pcall(function() fillFunc:InvokeServer(newBlock,b.brickColor,b.material) end) end
                pcall(function() moveFunc:InvokeServer(newBlock,b.cf) end)
            end
            task.wait(fastBuild and 0.01 or 0.03)
        end
        negateProgressText.Text="done! ("..total.." pieces)"
        task.wait(2); negateProgressText.Text=""
    end)
    negateMarked={}; updateNegateCount()
    negateMode=false
    negateModeBtn.Text="MARK MODE: OFF"; negateModeBtn.BackgroundColor3=colorActivo
end

