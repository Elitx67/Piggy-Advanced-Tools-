track(Services.UserInput.InputChanged:Connect(function(input)
    if not boxSelectModeEnabled or not boxSelectActive then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        local newPos = Vector2.new(input.Position.X, input.Position.Y)
        if bsTouchA and input == bsTouchA.id then
            bsTouchA.pos = newPos
        elseif bsTouchB and input == bsTouchB.id then
            bsTouchB.pos = newPos
        end
        if bsTouchA and bsTouchB then
            updateBoxFrameFromCorners(bsTouchA.pos, bsTouchB.pos)
            updateLiveBoxSelect()
        elseif bsTouchA then
            boxSelectFrame.Position = UDim2.fromOffset(bsTouchA.pos.X - 1, bsTouchA.pos.Y - 1)
            boxSelectFrame.Size = UDim2.fromOffset(2, 2)
        end
    elseif input.UserInputType == Enum.UserInputType.MouseMovement then
        if not boxSelectStartPos then return end
        local cp = Vector2.new(input.Position.X, input.Position.Y)
        local sp = boxSelectStartPos
        boxSelectFrame.Position = UDim2.fromOffset(math.min(sp.X, cp.X), math.min(sp.Y, cp.Y))
        boxSelectFrame.Size = UDim2.fromOffset(math.abs(cp.X - sp.X), math.abs(cp.Y - sp.Y))
        updateLiveBoxSelect()
    end
end))

track(Services.UserInput.InputEnded:Connect(function(input)
