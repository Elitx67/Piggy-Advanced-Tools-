local function paintNegate(c, mark)
    local function one(p)
        if not p:IsA("BasePart") or p.Name == "MouseFilterPart" or p.Name == "base" then return end
        if mark then
            if not negateOrig[p] then negateOrig[p] = {p.Transparency, p.Color} end
            p.Transparency = 0.6; p.Color = Color3.fromRGB(255,40,40)
        else
            local o = negateOrig[p]
            if o then p.Transparency = o[1]; p.Color = o[2]; negateOrig[p] = nil end
        end
    end
    one(c)
    for _, d in ipairs(c:GetDescendants()) do one(d) end
end

function clearNegateMarks()
    for _, c in ipairs(negateMarked) do
        if c and c.Parent then pcall(paintNegate, c, false) end
    end
    negateMarked = {}
    destroyNegatePreview()
    updateNegateCount()
end

function markNegate(obj)
    local c = negateContainerOf(obj)
    if not c then return end
    for i, v in ipairs(negateMarked) do
        if v == c then
            table.remove(negateMarked, i)
            pcall(paintNegate, c, false)
            updateNegateCount()
            return
        end
    end
    table.insert(negateMarked, c)
    pcall(paintNegate, c, true)
    updateNegateCount()
end

