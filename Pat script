local function destroyNegatePreview()
    for _, entry in ipairs(negatePreviewParts) do
        pcall(function() entry.previewPart:Destroy() end)
    end
    negatePreviewParts = {}
end

local function buildNegatePreview()
    destroyNegatePreview()
    if not negatePreviewEnabled or #negateMarked == 0 then return end
    for _, obj in ipairs(negateMarked) do
        pcall(function()
            local previewParts = {}
            if obj:IsA("Model") then
                for _, c in ipairs(obj:GetDescendants()) do
                    if c:IsA("BasePart") then
                        local pp = Instance.new("Part")
                        pp.Name = "PAT_NegPreview"
                        pp.Size = c.Size; pp.CFrame = c.CFrame
                        pp.Anchored = true; pp.CanCollide = false; pp.CanQuery = false
                        pp.Transparency = 0.45
                        pp.Color = Color3.fromRGB(255,30,30)
                        pp.Material = Enum.Material.Neon
                        pp.CastShadow = false
                        pp.Parent = workspace
                        table.insert(negatePreviewParts, {previewPart=pp})
                    end
                end
            elseif obj:IsA("BasePart") then
                local pp = Instance.new("Part")
                pp.Name = "PAT_NegPreview"
                pp.Size = obj.Size; pp.CFrame = obj.CFrame
                pp.Anchored = true; pp.CanCollide = false; pp.CanQuery = false
                pp.Transparency = 0.45
                pp.Color = Color3.fromRGB(255,30,30)
                pp.Material = Enum.Material.Neon
                pp.CastShadow = false
                pp.Parent = workspace
                table.insert(negatePreviewParts, {previewPart=pp})
            end
        end)
    end
end

