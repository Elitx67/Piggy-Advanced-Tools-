    if _undoGroupActive then
        for _, sn in ipairs(group) do _undoGroupSnapshots[#_undoGroupSnapshots+1] = sn end
        return
    end
    table.insert(undoStack, {group=group})
    if #undoStack > maxUndo then table.remove(undoStack,1) end
    redoStack = {}
end

function computeHandleOffset(proxyCF, proxySize, normalDir, container)
    local shape = "box"
    if container then
        local name = (container.Name or ""):lower()
        if name:find("sphere") then shape="sphere"
        elseif name:find("cylinder") then shape="cylinder" end
    end
    local localNormal = normalDir
    local halfSize = proxySize * 0.5
    local offset = Vector3.new(halfSize.X*localNormal.X, halfSize.Y*localNormal.Y, halfSize.Z*localNormal.Z)
    if shape == "sphere" then
        local r = math.min(halfSize.X, halfSize.Y, halfSize.Z)
        if localNormal.Magnitude > 0.001 then offset = localNormal.Unit * r end
    elseif shape == "cylinder" then
        local r = math.min(halfSize.X, halfSize.Y)
        local radial = Vector3.new(localNormal.X, localNormal.Y, 0)
        if radial.Magnitude > 0.001 then radial = radial.Unit * r end
        offset = Vector3.new(radial.X, radial.Y, halfSize.Z*localNormal.Z)
    end
    return proxyCF * CFrame.new(offset)
end

